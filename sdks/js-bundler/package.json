{
  "name": "vaka-bundler-plugin",
  "version": "0.2.0",
  "description": "Upload source maps to Vaka from Vite, Rollup and webpack builds",
  "license": "MIT OR Apache-2.0",
  "repository": {"type": "git", "url": "https://github.com/ErikHellman/vaka", "directory": "sdks/js-bundler"},
  "keywords": ["vaka", "sourcemaps", "vite-plugin", "rollup-plugin", "webpack-plugin"],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {"types": "./index.d.ts", "import": "./index.mjs", "require": "./index.cjs"}
  },
  "files": ["index.cjs", "index.mjs", "index.d.ts", "README.md"],
  "engines": {"node": ">=18"},
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
