{
  "name": "@hellsoft/vaka-browser",
  "publishConfig": {"access": "public"},
  "version": "0.3.0",
  "description": "Vaka browser SDK: crash reporting, cookieless analytics and user feedback",
  "license": "MIT OR Apache-2.0",
  "repository": {"type": "git", "url": "https://github.com/ErikHellman/vaka", "directory": "sdks/js"},
  "type": "module",
  "main": "./dist/vaka.cjs",
  "module": "./dist/vaka.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/vaka.mjs", "require": "./dist/vaka.cjs"},
    "./feedback": {"types": "./dist/feedback.d.ts", "import": "./dist/feedback.mjs", "require": "./dist/feedback.cjs"}
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
