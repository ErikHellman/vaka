<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Vaka</PackageId>
    <Description>Vaka SDK for .NET: crash and exception reporting, breadcrumbs, release health sessions, analytics events and feature flags for the Vaka service.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vaka.Tests" />
    <InternalsVisibleTo Include="Vaka.AspNetCore" />
    <InternalsVisibleTo Include="Vaka.OpenTelemetry" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
