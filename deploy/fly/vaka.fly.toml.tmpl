# Fly.io config template for the Vaka server.
# Do not edit the generated fly.toml: change deploy/fly/fly.env and run
#   deploy/fly/fly.sh render   (or deploy / launch, which render first).
# Placeholders are filled in by deploy/fly/fly.sh from deploy/fly/fly.env.
app = "${VAKA_FLY_APP}"
primary_region = "${VAKA_FLY_REGION}"

[build]
  dockerfile = "Dockerfile"

[env]
  VAKA_PUBLIC_URL = "${VAKA_PUBLIC_URL}"
  VAKA_DATA_DIR = "/data"
  VAKA_LISTEN = "0.0.0.0:8080"
  VAKA_CLICKHOUSE_URL = "http://${VAKA_FLY_CLICKHOUSE_APP}.internal:8123"
  VAKA_CLICKHOUSE_USER = "vaka"
  # Secrets: VAKA_CLICKHOUSE_PASSWORD, VAKA_ADMIN_EMAIL, VAKA_ADMIN_PASSWORD (set by fly.sh launch)

[mounts]
  source = "vaka_data"
  destination = "/data"

[http_service]
  internal_port = 8080
  force_https = true
  # Ingest must always be reachable, so keep the single machine running.
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

  [http_service.concurrency]
    type = "requests"
    soft_limit = 500
    hard_limit = 1000

  [[http_service.checks]]
    grace_period = "20s"
    interval = "30s"
    method = "GET"
    path = "/health"
    timeout = "5s"

[[vm]]
  size = "${VAKA_FLY_VM_SIZE}"
  memory = "${VAKA_FLY_VM_MEMORY}"
