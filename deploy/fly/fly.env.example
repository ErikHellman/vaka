# Settings for deploy/fly/fly.sh. Copy to deploy/fly/fly.env (git-ignored) and edit.
# Everything except VAKA_FLY_APP has a default; values set in the shell win over this file.

# Server app name. Fly app names are global, so pick your own. Required.
VAKA_FLY_APP=my-vaka
# Private ClickHouse app. Default: <VAKA_FLY_APP>-clickhouse
# VAKA_FLY_CLICKHOUSE_APP=my-vaka-clickhouse
# Fly region for both apps (fly platform regions). Default: arn
# VAKA_FLY_REGION=arn
# Fly organization for `launch` (fly orgs list). Default: your personal org
# VAKA_FLY_ORG=personal
# Public URL of the instance. Default: https://<VAKA_FLY_APP>.fly.dev
# Set it when you add a custom domain (fly certs add vaka.example.com).
# VAKA_PUBLIC_URL=https://vaka.example.com

# Deploy a published image instead of building from source, e.g. ghcr.io/erikhellman/vaka:0.3.0
# VAKA_FLY_IMAGE=

# Machine and volume sizes.
# VAKA_FLY_VM_SIZE=shared-cpu-1x
# VAKA_FLY_VM_MEMORY=512mb
# VAKA_FLY_VOLUME_GB=3
# VAKA_FLY_CLICKHOUSE_VM_SIZE=shared-cpu-2x
# VAKA_FLY_CLICKHOUSE_VM_MEMORY=2gb
# VAKA_FLY_CLICKHOUSE_VOLUME_GB=10

# First owner account, set as secrets by `launch`. A password is generated when left empty.
VAKA_ADMIN_EMAIL=you@example.com
# VAKA_ADMIN_PASSWORD=
