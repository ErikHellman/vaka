# Forwards everything that still reaches the old Fly.io app (SDKs configured with
# https://<app>.fly.dev) to the instance's new home, so apps keep reporting while they are
# updated to the new URL. Configured with environment variables (see fly.toml):
#
#   VAKA_FORWARD_TO      required: the new hostname, e.g. vaka.example.com
#   VAKA_FORWARD_SCHEME  scheme of the new host (default https)
#   VAKA_FORWARD_PORT    port this forwarder listens on (default 8080, Fly's internal_port)
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$VAKA_FORWARD_PORT:8080} {
	reverse_proxy {$VAKA_FORWARD_SCHEME:https}://{$VAKA_FORWARD_TO} {
		header_up Host {$VAKA_FORWARD_TO}
	}
}
