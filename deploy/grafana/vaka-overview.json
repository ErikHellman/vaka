          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "${vaka_url}/api/v1/projects/${project}/analytics/breakdown?dimension=path&limit=10&since=${__from}&until=${__to}",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "rows",
          "columns": [
            {
              "selector": "value",
              "text": "page",
