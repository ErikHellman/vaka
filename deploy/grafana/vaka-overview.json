          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "${vaka_url}/api/v1/projects/${project}/analytics/timeseries?since=${__from}&until=${__to}",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "series",
          "columns": [
            {
              "selector": "bucket",
