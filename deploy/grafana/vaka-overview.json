{
  "title": "Vaka overview",
  "uid": "vaka-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "vaka"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "yesoreyeram-infinity-datasource",
        "label": "Vaka (Infinity)"
      },
      {
        "name": "vaka_url",
        "type": "textbox",
        "label": "Vaka URL",
        "query": "https://vaka.example.com",
        "current": {
          "text": "https://vaka.example.com",
          "value": "https://vaka.example.com"
        }
      },
      {
        "name": "project",
        "type": "textbox",
        "label": "Project slug",
        "query": "web",
        "current": {
          "text": "web",
          "value": "web"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Visitors (last 5 min)",
      "type": "stat",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${datasource}"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "${vaka_url}/api/v1/projects/${project}/analytics/realtime?minutes=5",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "visitors",
              "text": "visitors",
              "type": "number"
            }
          ]
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^visitors$/"
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Pageviews (last 5 min)",
      "type": "stat",
      "datasource": {
