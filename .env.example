# Public URL of this instance (used in links, alerts and install instructions).
VAKA_PUBLIC_URL=http://localhost:8080
# First owner account, created on first start when no users exist.
VAKA_ADMIN_EMAIL=admin@example.com
VAKA_ADMIN_PASSWORD=change-me-please
# Metadata store: SQLite (default) or Postgres.
# VAKA_DB_URL=sqlite:///data/vaka.db?mode=rwc
# VAKA_DB_URL=postgres://vaka:vaka@postgres:5432/vaka
# ClickHouse password (also used by the clickhouse service).
CLICKHOUSE_PASSWORD=vaka
# Email alerts and invites through Resend (optional).
# VAKA_RESEND_API_KEY=re_...
# VAKA_EMAIL_FROM=Vaka <alerts@example.com>
# With email configured the admin UI also offers one-time email codes; set this to use codes only.
# VAKA_PASSWORD_LOGIN=false
# Default retention for new projects, in days.
# VAKA_DEFAULT_RETENTION_DAYS=90
# Optional MaxMind/DB-IP country database (.mmdb) for country lookup.
# VAKA_GEOIP_DB=/data/GeoLite2-Country.mmdb
