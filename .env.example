# Public URL of this instance (used in links, alerts and install instructions).
# With the caddy profile this is https://<VAKA_DOMAIN>.
VAKA_PUBLIC_URL=http://localhost:8080
# First owner account, created on first start when no users exist.
VAKA_ADMIN_EMAIL=admin@example.com
VAKA_ADMIN_PASSWORD=change-me-please
# Metadata store: SQLite (default) or Postgres.
# VAKA_DB_URL=sqlite:///data/vaka.db?mode=rwc
# VAKA_DB_URL=postgres://vaka:vaka@postgres:5432/vaka
# ClickHouse password (also used by the clickhouse service). Change it for real deployments.
CLICKHOUSE_PASSWORD=vaka

# Optional services, comma separated: caddy (HTTPS reverse proxy), postgres (metadata store).
# COMPOSE_PROFILES=caddy,postgres
# Domain Caddy gets a certificate for (caddy profile). Point its DNS at this host.
# VAKA_DOMAIN=vaka.example.com
# Host port for plain HTTP. Use 127.0.0.1:8080 behind Caddy or another local proxy.
# VAKA_PORT=8080
# Server image and version (default ghcr.io/erikhellman/vaka:latest). Pin a release in production.
# VAKA_IMAGE=ghcr.io/erikhellman/vaka
# VAKA_VERSION=0.3.0
# Postgres password (postgres profile); use the same value in VAKA_DB_URL.
# POSTGRES_PASSWORD=vaka
# Email alerts and invites through Resend (optional).
# VAKA_RESEND_API_KEY=re_...
# VAKA_EMAIL_FROM=Vaka <alerts@example.com>
# With email configured the admin UI also offers one-time email codes; set this to use codes only.
# VAKA_PASSWORD_LOGIN=false
# Opening paragraph of digests written by an OpenAI-compatible LLM (optional; a template is used otherwise).
# VAKA_LLM_BASE_URL=https://api.openai.com/v1
# VAKA_LLM_MODEL=gpt-4.1-mini
# VAKA_LLM_API_KEY=sk-...
# Store debug files in an S3-compatible bucket instead of only on local disk (optional).
# VAKA_S3_BUCKET=vaka-debug-files
# VAKA_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# VAKA_S3_REGION=auto
# VAKA_S3_ACCESS_KEY_ID=...
# VAKA_S3_SECRET_ACCESS_KEY=...
# Default retention for new projects, in days.
# VAKA_DEFAULT_RETENTION_DAYS=90
# Optional MaxMind/DB-IP country database (.mmdb) for country lookup.
# VAKA_GEOIP_DB=/data/GeoLite2-Country.mmdb
